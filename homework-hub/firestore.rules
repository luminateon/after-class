rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /planners/{roomId} {
      // Capability-link model: anyone signed in anonymously who knows the
      // unguessable room ID can read and write its content.
      allow get: if request.auth != null
        && roomId.matches('^[a-zA-Z0-9_-]{20,100}$');
      allow create, update: if request.auth != null
        && roomId.matches('^[a-zA-Z0-9_-]{20,100}$')
        && request.resource.data.keys().hasOnly(['subjects','students','tasks','classes'])
        && request.resource.data.tasks.size() <= 1000
        && request.resource.data.students.size() <= 100
        && request.resource.data.subjects.size() <= 100
        && request.resource.data.classes.size() <= 500;
    }
  }
}
